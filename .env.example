# Copier ce fichier vers .env puis adapter les valeurs.

# URL publique du site (utilisée pour générer les liens/QR codes des invitations)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL
# Dev local : docker compose up -d (port hôte 5434)
DATABASE_URL=postgresql://wedding:wedding@localhost:5434/wedding

# Compte SUPER_ADMIN créé par le seed (ne jamais mettre un vrai mot de passe ici)
SEED_SUPER_ADMIN_EMAIL=admin@wedding.local
SEED_SUPER_ADMIN_PASSWORD=changez-moi
# Mot de passe des comptes de démo (admins / agents) créés par le seed
SEED_DEMO_PASSWORD=changez-moi

# --- Variables à venir (phases suivantes) ---
# AUTH_SECRET=
